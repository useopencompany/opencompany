{
  "name": "cursor-clone",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "bun run db:migrate && next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "setup": "node scripts/setup.mjs",
    "db:generate": "drizzle-kit generate",
