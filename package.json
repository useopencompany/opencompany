{
  "name": "cursor-clone",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.2",
  "engines": {
    "node": ">=20.20.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev --filter=@opencompany/web",
    "build": "turbo build",
    "vercel-build": "bun run db:migrate && turbo build --filter=@opencompany/web",
    "start": "bun --filter @opencompany/web start",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "typecheck": "turbo typecheck",
    "setup": "node scripts/setup.mjs",
    "env:pull": "node scripts/setup.mjs --pull-env",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node scripts/seed.mjs",
    "db:branch:create": "node scripts/neon-branch.mjs create",
    "db:branch:delete": "node scripts/neon-branch.mjs delete"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "dotenv": "^17.4.2",
    "vercel": "^54.2.0"
  },
  "overrides": {
    "postcss": "$postcss"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.10",
    "neonctl": "^2.22.0",
    "postcss": "8.5.15",
    "turbo": "^2.9.14",
    "typescript": "^6.0.3"
  }
}
