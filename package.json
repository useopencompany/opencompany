{
  "name": "opencompany",
  "version": "0.2.0",
  "license": "MIT",
  "private": true,
  "packageManager": "bun@1.3.2",
  "engines": {
    "node": ">=20.20.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs --ui=tui --filter=@opencompany/web --filter=@opencompany/api --filter=@opencompany/runner --filter=@opencompany/stripe-webhooks",
    "dev:stream": "node scripts/dev.mjs --ui=stream --filter=@opencompany/web --filter=@opencompany/api --filter=@opencompany/runner --filter=@opencompany/stripe-webhooks",
    "dev:logs": "node scripts/dev-logs.mjs",
    "dev:web": "node scripts/dev.mjs --ui=tui --filter=@opencompany/web --filter=@opencompany/api --filter=@opencompany/runner --filter=@opencompany/stripe-webhooks",
    "web:capabilities:contract": "bun --cwd apps/web capabilities:contract",
    "dev:ds": "turbo dev --ui=tui --filter=@opencompany/design-system",
    "dev:docs": "turbo dev --ui=tui --filter=@opencompany/docs",
    "dev:marketing": "turbo dev --ui=tui --filter=@opencompany/marketing",
    "dev:runner": "turbo dev --ui=stream --filter=@opencompany/runner",
    "dev:electron": "bun run --cwd apps/desktop dev",
    "dev:electron:local": "bun run --cwd apps/desktop dev:local",
    "dev:kill-port": "node scripts/kill-port.mjs",
    "dev:kill-3000": "node scripts/kill-port.mjs 3000",
    "build": "bun --bun turbo build",
    "build:docs": "bun --bun turbo build --filter=@opencompany/docs",
    "vercel-build": "turbo build --filter=@opencompany/web",
    "vercel-build:web": "turbo build --filter=@opencompany/web",
    "vercel-build:marketing": "turbo build --filter=@opencompany/marketing",
    "start": "bun --filter @opencompany/web start",
    "start:docs": "bun --filter @opencompany/docs start",
    "start:web": "bun --filter @opencompany/web start",
    "lint": "bun run boundary:check && turbo lint",
    "lint:fix": "turbo lint:fix",
    "boundary:check": "node scripts/check-web-domain-boundary.mjs && node scripts/check-wiki-db-boundary.mjs && node scripts/check-naming-boundary.mjs && node scripts/check-doc-links.mjs",
    "naming:check": "node scripts/check-naming-boundary.mjs",
    "docs:links:check": "node scripts/check-doc-links.mjs",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "typecheck": "turbo typecheck",
    "test": "bun --bun turbo test",
    "test:watch": "turbo test -- --watch",
    "secrets:check": "trufflehog git file://. --since-commit origin/main --branch HEAD --results=verified,unknown --fail --no-update",
    "infisical:dev": "infisical run --env=dev --path=/web --path=/runner -- bun run dev",
    "infisical:dev:web": "infisical run --env=dev --path=/web --path=/runner -- bun run dev:web",
    "infisical:dev:runner": "infisical run --env=dev --path=/runner -- bun run dev:runner",
    "infisical:export": "node scripts/infisical-export-local.mjs",
    "infisical:release:preflight": "infisical run --env=prod --path=/release -- bun run release:preflight -- --release",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release:plan": "node scripts/release-plan.mjs",
    "release:deployment": "node scripts/release-deployment.mjs",
    "release:scope": "node scripts/release-scope.mjs",
    "release:render": "node scripts/render-release.mjs",
    "release:render:services": "node scripts/release-render-services.mjs",
    "release:smoke": "node scripts/release-smoke.mjs",
    "release:vercel:prepare": "node scripts/release-vercel-prepare.mjs",
    "setup": "node scripts/cleanup-local-electric.mjs && node scripts/setup.mjs",
    "setup:dev": "node scripts/setup.mjs --dev",
    "setup:stripe": "node scripts/setup.mjs --stripe",
    "mcp:configure": "node scripts/configure-agent-mcp.mjs",
    "env:pull": "node scripts/setup.mjs --pull-env",
    "github:tunnel": "node scripts/github-tunnel.mjs",
    "db:generate": "bun --filter @opencompany/db db:generate",
    "db:migrate": "bun --filter @opencompany/db db:migrate",
    "db:migrations:check": "node scripts/check-migration-journal.mjs",
    "db:queue:maintenance": "bun --filter @opencompany/runner postgres:queue:maintenance",
    "db:seed": "node scripts/seed.mjs",
    "db:cloud-base:refresh": "node scripts/neon-cloud-base.mjs",
    "db:branch:create": "node scripts/neon-branch.mjs create",
    "db:branch:delete": "node scripts/neon-branch.mjs delete",
    "electric:dev": "node scripts/electric-dev.mjs",
    "measure:chat-presentation": "bun scripts/measure-headless-chat-presentation.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@opencompany/db": "workspace:*",
    "@opencompany/wiki": "workspace:*",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "eslint-config-next": "16.2.10",
    "next": "16.2.11",
    "pg": "^8.23.0",
    "vercel": "^59.11.2"
  },
  "overrides": {
    "@floating-ui/core": "1.8.0",
    "@floating-ui/dom": "1.8.0",
    "@tiptap/core": "3.30.5",
    "@tiptap/extension-blockquote": "3.30.5",
    "@tiptap/extension-bold": "3.30.5",
    "@tiptap/extension-bubble-menu": "3.30.5",
    "@tiptap/extension-bullet-list": "3.30.5",
    "@tiptap/extension-code": "3.30.5",
    "@tiptap/extension-code-block": "3.30.5",
    "@tiptap/extension-collaboration": "3.30.5",
    "@tiptap/extension-document": "3.30.5",
    "@tiptap/extension-drag-handle": "3.30.5",
    "@tiptap/extension-drag-handle-react": "3.30.5",
    "@tiptap/extension-dropcursor": "3.30.5",
    "@tiptap/extension-floating-menu": "3.30.5",
    "@tiptap/extension-gapcursor": "3.30.5",
    "@tiptap/extension-hard-break": "3.30.5",
    "@tiptap/extension-heading": "3.30.5",
    "@tiptap/extension-horizontal-rule": "3.30.5",
    "@tiptap/extension-italic": "3.30.5",
    "@tiptap/extension-link": "3.30.5",
    "@tiptap/extension-list": "3.30.5",
    "@tiptap/extension-list-item": "3.30.5",
    "@tiptap/extension-list-keymap": "3.30.5",
    "@tiptap/extension-node-range": "3.30.5",
    "@tiptap/extension-ordered-list": "3.30.5",
    "@tiptap/extension-paragraph": "3.30.5",
    "@tiptap/extension-strike": "3.30.5",
    "@tiptap/extension-text": "3.30.5",
    "@tiptap/extension-underline": "3.30.5",
    "@tiptap/extensions": "3.30.5",
    "@tiptap/markdown": "3.30.5",
    "@tiptap/pm": "3.30.5",
    "@tiptap/react": "3.30.5",
    "@tiptap/starter-kit": "3.30.5",
    "@tiptap/suggestion": "3.30.5",
    "postcss": "$postcss",
    "prosemirror-changeset": "2.4.1",
    "prosemirror-commands": "1.7.1",
    "prosemirror-dropcursor": "1.8.2",
    "prosemirror-gapcursor": "1.4.1",
    "prosemirror-history": "1.5.0",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-model": "1.25.7",
    "prosemirror-schema-list": "1.5.1",
    "prosemirror-state": "1.4.4",
    "prosemirror-tables": "1.8.5",
    "prosemirror-transform": "1.12.0",
    "prosemirror-view": "1.41.8",
    "sharp": "0.35.4",
    "tar": "7.5.22"
  },
  "trustedDependencies": [
    "electron"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^29.1.1",
    "neonctl": "^3.6.0",
    "postcss": "8.5.28",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
