{
  "name": "@opencompany/protocol",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./events": {
      "types": "./src/events.ts",
      "default": "./src/events.ts"
    },
    "./openapi": "./openapi/openapi.v1.json"
  },
  "scripts": {
    "openapi:generate": "bun run scripts/generate-openapi.ts",
    "openapi:check": "bun run scripts/check-openapi.ts",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.5.2",
    "hono": "4.12.34",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
