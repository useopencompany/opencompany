{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "betterstack",
  "version": "1.0.0",
  "description": "Investigate Better Stack observability data and manage monitoring, incidents, dashboards, and team access.",
  "author": {
    "name": "opencompany",
    "url": "https://opencompany.com"
  },
  "homepage": "https://betterstack.com/docs/getting-started/integrations/mcp/",
  "repository": "https://github.com/useopencompany/plugins/tree/main/betterstack",
  "license": "MIT",
  "keywords": ["better-stack", "observability", "monitoring", "incidents", "telemetry"],
  "extensions": {
    "so.opencompany.capabilities": {
      "read": {
        "label": "Search Better Stack docs",
        "defaultMode": "on",
        "tools": ["documentation"]
      },
      "query": {
        "label": "Inspect observability data",
        "defaultMode": "ask",
        "tools": [
          "application",
          "applications",
          "available_incident_escalation_policies",
          "chart",
          "chart_alert",
          "chart_alert_help",
          "chart_alerts",
          "chart_building_help",
          "clusters",
          "dashboard",
          "dashboard_query_help",
          "dashboard_templates",
          "dashboards",
          "data_regions",
          "error",
          "errors",
          "errors_query_help",
          "escalation_policies",
          "escalation_policy",
          "explore_logs_query_help",
          "export_dashboard",
          "heartbeat",
          "heartbeat_availability",
          "heartbeats",
          "incident",
          "incident_comments",
          "incident_timeline",
          "incidents",
          "metric",
          "metric_expressions",
          "metrics_query_help",
          "metrics_schema",
          "monitor",
          "monitor_availability",
          "monitor_response_times",
          "monitors",
          "on_call",
          "on_call_event",
          "on_call_events",
          "on_call_rotation",
          "on_calls",
          "query",
          "query_help",
          "releases",
          "render_chart",
          "replays_query_help",
          "severities",
          "severity",
          "source",
          "source_fields",
          "sources",
          "status_page",
          "status_page_report_update",
          "status_page_report_updates",
          "status_page_reports",
          "status_page_resources",
          "status_page_sections",
          "status_pages",
          "team_members",
          "team_roles",
          "teams"
        ]
      },
      "write": {
        "label": "Manage Better Stack",
        "defaultMode": "ask",
        "tools": [
          "acknowledge_incident",
          "add_chart_to_dashboard",
          "add_dashboard_section",
          "change_team_member_role",
          "create_application",
          "create_chart_alert",
          "create_cloud_connection",
          "create_dashboard",
          "create_heartbeat",
          "create_incident",
          "create_incident_comment",
          "create_metric_expression",
          "create_monitor",
          "create_source",
          "create_status_page_report",
          "create_status_page_report_update",
          "create_status_page_resource",
          "create_status_page_section",
          "delete_chart_alert",
          "delete_metric_expression",
          "edit_application",
          "edit_chart",
          "edit_chart_alert",
          "edit_dashboard",
          "edit_dashboard_section",
          "escalate_incident",
          "import_dashboard",
          "invite_team_member",
          "move_charts",
          "remove_chart",
          "remove_dashboard",
          "remove_dashboard_section",
          "remove_dashboard_variable",
          "remove_status_page_resource",
          "remove_status_page_section",
          "remove_team_member",
          "reopen_incident",
          "resolve_incident",
          "set_dashboard_variable",
          "toggle_chart_alert_pause",
          "update_error_state",
          "update_metric_expression",
          "update_status_page",
          "update_status_page_resource",
          "update_status_page_section"
        ]
      }
    }
  }
}
