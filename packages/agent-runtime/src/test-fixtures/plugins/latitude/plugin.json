{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "latitude",
  "version": "1.0.0",
  "description": "Inspect Latitude projects and observability data, and manage workspace resources with approval.",
  "author": {
    "name": "opencompany",
    "url": "https://opencompany.com"
  },
  "homepage": "https://docs.latitude.so/getting-started/mcp",
  "repository": "https://github.com/useopencompany/plugins/tree/main/latitude",
  "license": "MIT",
  "keywords": ["latitude", "observability", "traces", "agents", "evaluations"],
  "extensions": {
    "so.opencompany.capabilities": {
      "read": {
        "label": "Inspect Latitude workspace",
        "defaultMode": "on",
        "tools": [
          "listProjects",
          "getProject",
          "listTools",
          "getToolCallHistogram",
          "getToolContext",
          "getToolCoOccurrence",
          "getToolErrors",
          "getTool",
          "listSavedSearches",
          "getSavedSearch",
          "listSignals",
          "getSignalAnalytics",
          "getSignal",
          "getSignalTrend",
          "listIncidents",
          "listDatasets",
          "getDataset",
          "listDatasetColumns",
          "listMonitors",
          "listMonitorsForTarget",
          "getMonitor",
          "listMonitorIncidents",
          "listExperiments",
          "getExperiment",
          "listImports",
          "getImport"
        ]
      },
      "query": {
        "label": "Read traces and user data",
        "defaultMode": "ask",
        "tools": [
          "listTraces",
          "getTraceAnalytics",
          "getTrace",
          "listTraceSpans",
          "getTraceSpan",
          "listTraceAnnotations",
          "getTraceAnnotation",
          "getTraceMemory",
          "getTraceMemoryChanges",
          "getToolParameters",
          "listToolCalls",
          "listUsers",
          "getUsersOverview",
          "getUserActivity",
          "getUserUsage",
          "listUserSignals",
          "listUserBehaviours",
          "listUserMemoryStores",
          "getUser",
          "listSavedSearchTraces",
          "listSignalTraces",
          "listDatasetRows",
          "listApiKeys",
          "getApiKey",
          "listOAuthKeys",
          "getOAuthKey",
          "getAccount",
          "listMembers",
          "getMember",
          "queryAnalytics",
          "querySpans",
          "listSessions",
          "getSessionAnalytics",
          "getSession",
          "listSessionTraces",
          "listSessionSignals",
          "getSessionSignal",
          "getSessionMemory",
          "getSessionMemoryChanges",
          "listMemoryStores",
          "getMemoryStore",
          "getMemoryStoreDiff",
          "listMemoryStoreUsers",
          "getMemoryRecord",
          "getMemoryRecordChange",
          "listMemoryRecordReads",
          "listMemoryRecordUsers"
        ]
      },
      "write": {
        "label": "Manage Latitude",
        "defaultMode": "ask",
        "tools": [
          "createProject",
          "updateProject",
          "deleteProject",
          "createScore",
          "createAnnotation",
          "exportTraces",
          "createSavedSearch",
          "updateSavedSearch",
          "deleteSavedSearch",
          "createSignal",
          "updateSignal",
          "deleteSignal",
          "resolveSignals",
          "unresolveSignals",
          "ignoreSignals",
          "unignoreSignals",
          "muteSignals",
          "unmuteSignals",
          "monitorSignal",
          "unmonitorSignal",
          "submitSignalFeedback",
          "exportSignals",
          "resolveIncident",
          "createDataset",
          "updateDataset",
          "deleteDataset",
          "insertDatasetRows",
          "updateDatasetRow",
          "deleteDatasetRows",
          "importDatasetRowsFromTraces",
          "exportDatasetRows",
          "addDatasetColumn",
          "updateDatasetColumn",
          "deleteDatasetColumn",
          "reorderDatasetColumns",
          "restoreDatasetColumn",
          "createApiKey",
          "updateApiKey",
          "revokeApiKey",
          "revokeOAuthKey",
          "inviteMember",
          "updateMember",
          "removeMember",
          "createMonitor",
          "updateMonitor",
          "deleteMonitor",
          "muteMonitor",
          "unmuteMonitor",
          "createExperiment",
          "updateExperiment",
          "deleteExperiment",
          "createImport",
          "cancelImport",
          "retryImport"
        ]
      }
    }
  }
}
