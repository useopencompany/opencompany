{
  "name": "@opencompany/goat-brain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "goat-brain": "./src/cli/index.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./document": {
      "types": "./src/document.ts",
      "default": "./src/document.ts"
    },
    "./folders": {
      "types": "./src/folders.ts",
      "default": "./src/folders.ts"
    },
    "./cli-bundle": {
      "types": "./src/generated/cli-bundle.ts",
      "default": "./src/generated/cli-bundle.ts"
    },
    "./inline-links": {
      "types": "./src/inline-links.ts",
      "default": "./src/inline-links.ts"
    },
    "./ingest-trace": {
      "types": "./src/ingest-trace.ts",
      "default": "./src/ingest-trace.ts"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "default": "./src/schema.ts"
    },
    "./skills": {
      "types": "./src/skills.ts",
      "default": "./src/skills.ts"
    },
    "./workflows": {
      "types": "./src/workflows.ts",
      "default": "./src/workflows.ts"
    },
    "./usage": {
      "types": "./src/usage.ts",
      "default": "./src/usage.ts"
    }
  },
  "scripts": {
    "bundle": "bun scripts/build-bundle.mjs",
    "build": "bun scripts/build-bundle.mjs",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "minisearch": "^7.1.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
