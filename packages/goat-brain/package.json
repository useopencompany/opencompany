{
  "name": "@opencompany/goat-brain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "goat-brain": "./src/cli/index.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./cli-bundle": {
      "types": "./src/generated/cli-bundle.ts",
      "default": "./src/generated/cli-bundle.ts"
    },
    "./usage": {
      "types": "./src/usage.ts",
      "default": "./src/usage.ts"
    }
  },
  "scripts": {
    "bundle": "bun scripts/build-bundle.mjs",
    "build": "bun scripts/build-bundle.mjs",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "minisearch": "^7.1.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
