{
  "name": "@opencompany/agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./prompts": {
      "types": "./src/prompts/index.ts",
      "default": "./src/prompts/index.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/mcp": "^2.0.32",
    "@browserbasehq/sdk": "^2.18.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@opencompany/agent-runtime": "workspace:*",
    "@opencompany/analytics": "workspace:*",
    "@opencompany/billing": "workspace:*",
    "@opencompany/browser-tools": "workspace:*",
    "@opencompany/crypto": "workspace:*",
    "@opencompany/core": "workspace:*",
    "@opencompany/db": "workspace:*",
    "@opencompany/brain": "workspace:*",
    "@opencompany/telemetry": "workspace:*",
    "@opencompany/wiki": "workspace:*",
    "@opencompany/observability": "workspace:*",
    "@vercel/blob": "^2.4.0",
    "@vercel/sandbox": "^3.0.0",
    "ai": "^7.0.66",
    "ajv": "8.20.0",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.9",
    "mcp-handler": "^2.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
