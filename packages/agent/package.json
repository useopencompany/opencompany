    "@opencompany/analytics": "workspace:*",
    "@opencompany/billing": "workspace:*",
    "@opencompany/browser-tools": "workspace:*",
    "@opencompany/crypto": "workspace:*",
    "@opencompany/core": "workspace:*",
    "@opencompany/db": "workspace:*",
    "@opencompany/brain": "workspace:*",
    "@opencompany/file-extract": "workspace:*",
    "@opencompany/telemetry": "workspace:*",
    "@opencompany/wiki": "workspace:*",
    "@opencompany/observability": "workspace:*",
    "@vercel/blob": "^2.8.0",
    "@vercel/sandbox": "^2.9.0",
    "ai": "^6.0.189",
    "ajv": "8.20.0",
    "drizzle-orm": "^0.45.2",
    "jose": "^5.10.0",
    "mcp-handler": "^1.1.0",
    "zod": "^4.4.3"
