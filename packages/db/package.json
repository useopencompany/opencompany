{
  "name": "@opencompany/db",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    },
    "./schema": {
      "types": "./src/schema.ts",
      "default": "./src/schema.ts"
    },
    "./pool": {
      "types": "./src/pool.ts",
      "default": "./src/pool.ts"
    },
    "./sync-outbox": {
      "types": "./src/sync-outbox.ts",
      "default": "./src/sync-outbox.ts"
    }
  },
  "scripts": {
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts",
    "typecheck": "tsc --noEmit --project tsconfig.json",
    "test": "tsc --noEmit --project tsconfig.json"
  },
  "dependencies": {
    "@opencompany/agent-runtime": "workspace:*",
    "@opencompany/crypto": "workspace:*",
    "@neondatabase/serverless": "^1.1.0",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.10",
    "typescript": "^6.0.3"
  }
}
