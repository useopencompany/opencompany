{
  "name": "@opencompany/goat-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./prompts": {
      "types": "./src/prompts/index.ts",
      "default": "./src/prompts/index.ts"
    },
