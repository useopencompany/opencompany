    "@opencompany/db": "workspace:*",
    "@opencompany/goat-brain": "workspace:*",
    "@opencompany/goat-observability": "workspace:*",
    "@opencompany/goat-wiki": "workspace:*",
    "ai": "^6.0.189",
    "ajv": "8.20.0",
    "drizzle-orm": "^0.45.2"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
