# Copy to .env (gitignored). All values are baked into the client bundle.

# Goat server base URL. The local dev server runs on http://localhost:3002
# (reachable from the iOS simulator). Use your machine's LAN IP for a physical
# device, or the production URL.
EXPO_PUBLIC_GOAT_API_URL="http://localhost:3002"

# Local-dev auth shortcut: must match GOAT_MOBILE_DEV_TOKEN in the repo-root
# .env. When set, the app skips sign-in entirely and sends this token as the
# bearer token. The server only honors it outside production.
EXPO_PUBLIC_GOAT_DEV_TOKEN=""

# Real sign-in (WorkOS AuthKit OAuth + PKCE). Requires the redirect URI
# goat://auth/callback to be added to the WorkOS app's redirect URIs.
EXPO_PUBLIC_WORKOS_CLIENT_ID=""
EXPO_PUBLIC_AUTHKIT_DOMAIN=""
