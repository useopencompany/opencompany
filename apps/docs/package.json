{
  "name": "@opencompany/docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run generate:openapi && next dev --port 3004",
    "build": "bun run docs:generate && next build",
    "start": "next start --port 3004",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "bun run docs:generate && tsc --noEmit",
    "docs:generate": "bun run generate:openapi && fumadocs-mdx",
    "generate:openapi": "bun scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@opencompany/protocol": "workspace:*",
    "fumadocs-core": "16.14.5",
    "fumadocs-mdx": "^15.3.0",
    "fumadocs-openapi": "^11.2.4",
    "fumadocs-ui": "16.14.5",
    "json-schema-typed": "^8.0.2",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "10.8.1",
    "eslint-config-next": "16.3.1",
    "postcss": "8.5.26",
    "tailwindcss": "^4.3.0",
    "typescript": "^7.0.2"
  }
}
