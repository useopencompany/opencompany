{
  "name": "@opencompany/goat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ../../scripts/next-goat.mjs dev",
    "build": "node ../../scripts/next-goat.mjs build",
    "vercel-build": "bun --cwd ../.. turbo build --filter=@opencompany/goat",
    "start": "node ../../scripts/next-goat.mjs start",
    "docs:generate": "fumadocs-mdx",
    "lint": "bun run docs:generate && eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "bun run docs:generate && tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/mcp": "^1.0.44",
    "@ai-sdk/react": "3.0.191",
    "@opencompany/agent-runtime": "workspace:*",
    "@opencompany/db": "workspace:*",
    "@opencompany/goat-brain": "workspace:*",
    "@opencompany/goat-observability": "workspace:*",
    "@opencompany/ui": "workspace:*",
    "@tanstack/electric-db-collection": "^0.3.5",
    "@tanstack/react-db": "^0.1.85",
    "@tiptap/core": "3.23.5",
    "@tiptap/markdown": "3.23.5",
    "@tiptap/pm": "^3.23.5",
    "@tiptap/react": "^3.23.5",
    "@tiptap/starter-kit": "^3.23.5",
    "@workos-inc/authkit-nextjs": "^4.1.0",
    "@workos-inc/node": "^9.3.1",
    "ai": "^6.0.189",
    "cron-parser": "^5.6.1",
    "drizzle-orm": "^0.45.2",
    "fumadocs-core": "^16.9.0",
    "fumadocs-mdx": "^15.0.7",
    "lucide-react": "^1.16.0",
    "next": "16.2.10",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/mdx": "^2.0.13",
    "@types/node": "^25.9.1",
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.10",
    "postcss": "8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
