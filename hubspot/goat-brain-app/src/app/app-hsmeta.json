{
  "uid": "goat_brain_hubspot_app",
  "type": "app",
  "config": {
    "description": "Feeds HubSpot CRM activity (contacts, companies, deals) into OpenCompany Goat Brain via read-only OAuth and webhooks.",
    "name": "OpenCompany Goat Brain",
    "distribution": "private",
    "auth": {
      "type": "oauth",
      "redirectUrls": [
        "https://my.opencompany.chat/api/integrations/hubspot/callback",
        "https://localhost:3443/api/integrations/hubspot/callback"
      ],
      "requiredScopes": [
        "oauth",
        "crm.objects.contacts.read",
        "crm.objects.companies.read",
        "crm.objects.deals.read"
      ],
      "optionalScopes": [],
      "conditionallyRequiredScopes": []
    },
    "permittedUrls": {
      "fetch": ["https://api.hubapi.com"],
      "iframe": [],
      "img": []
    },
    "support": {
      "supportEmail": "louis@acta.so",
      "documentationUrl": "https://my.opencompany.chat/docs",
      "supportUrl": "https://my.opencompany.chat",
      "supportPhone": "+18005555555"
    }
  }
}
