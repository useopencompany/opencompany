# Set by `bun run db:branch:create` — no need to fill in manually for local dev.
DATABASE_URL="postgresql://..."

# WorkOS AuthKit — grab from https://dashboard.workos.com
WORKOS_CLIENT_ID="client_..."
WORKOS_API_KEY="sk_test_..."
# 32+ characters. Generate with: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD="replace-with-at-least-32-characters"
NEXT_PUBLIC_WORKOS_REDIRECT_URI="http://localhost:3000/auth/callback"

# --- Neon (optional, only for CI / Vercel) ---
# Local dev: run `bunx neonctl auth` once, then `bun run db:branch:create`.
# NEON_PROJECT_ID is required if your Neon account has access to multiple projects.
NEON_PROJECT_ID="..."
# Optional overrides for nonstandard Neon projects. Defaults are neondb / neondb_owner.
# NEON_DATABASE_NAME="neondb"
# NEON_ROLE_NAME="neondb_owner"
# NEON_API_KEY is only needed in headless environments (Vercel/CI) where browser OAuth isn't possible.
# NEON_API_KEY=""
