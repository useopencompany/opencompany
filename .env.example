# Pulled from Infisical dev by `bun run env:pull`.
DATABASE_URL="postgresql://..."
# Optional local setup escape hatch: use Vercel's shared DATABASE_URL instead of a Neon branch.
OPENCOMPANY_SHARED_DATABASE="0"

# Neon local database branching.
# `bun run setup` creates a branch for the current Git branch by default.
NEON_PROJECT_ID="..."
# Optional for headless Neon CLI usage, such as CI.
NEON_API_KEY=""
# Optional: fork local branches from a stable seeded parent instead of the Neon default branch.
NEON_PARENT_BRANCH=""
# Optional: use when multiple local worktrees intentionally share the same Git branch.
NEON_BRANCH_NAME=""
# Optional: local Neon branches expire after 24 hours by default. Use 0 to disable.
NEON_BRANCH_TTL_HOURS="24"
# Optional: only needed for nonstandard Neon projects with multiple databases/roles.
NEON_DATABASE_NAME=""
NEON_ROLE_NAME=""

# WorkOS AuthKit — grab from https://dashboard.workos.com
WORKOS_CLIENT_ID="client_..."
WORKOS_API_KEY="sk_test_..."
# 32+ characters. Generate with: openssl rand -base64 32
WORKOS_COOKIE_PASSWORD="replace-with-at-least-32-characters"
NEXT_PUBLIC_WORKOS_REDIRECT_URI="http://localhost:3000/auth/callback"
# Optional server-only fallback. Usually leave unset and use NEXT_PUBLIC_WORKOS_REDIRECT_URI.
WORKOS_REDIRECT_URI=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Goat experiment app. `bun run setup` also mirrors the needed DB/Auth/runner/Electric
# values into apps/goat/.env.local for direct app-folder tooling.
GOAT_PORT="3002"
GOAT_HTTPS_PORT="3443"
GOAT_NEXT_PUBLIC_APP_URL="https://localhost:3443"
GOAT_NEXT_PUBLIC_WORKOS_REDIRECT_URI="https://localhost:3443/auth/callback"
# Optional local-only onboarding bypass. Ignored in production, CI, and hosted Vercel runtimes.
OPENCOMPANY_LOCAL_ONBOARDING_BYPASS_EMAILS="louis@acta.so"

# Stripe credit top-ups. Prefer a restricted test key; `bun run setup` can fill
# these from the logged-in Stripe CLI when placeholders are present.
STRIPE_SECRET_KEY="rk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
# Optional: use when your Stripe CLI login has multiple profiles.
STRIPE_CLI_PROJECT_NAME=""

# GitHub workspace-state storage. This installation backs OpenCompany-managed workspace repos.
OPENCOMPANY_GITHUB_ORG="your-github-org"
GITHUB_APP_ID="123456"
GITHUB_APP_INSTALLATION_ID="12345678"
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
# User-facing GitHub work integrations. This is separate from the workspace-state app above.
GITHUB_INTEGRATION_APP_ID="123456"
GITHUB_INTEGRATION_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
GITHUB_INTEGRATION_APP_SLUG="your-github-app"
GITHUB_INTEGRATION_APP_CLIENT_ID="Iv1..."
GITHUB_INTEGRATION_APP_CLIENT_SECRET="github-app-client-secret"
# 32+ characters. Used only to sign GitHub OAuth setup state.
GITHUB_INTEGRATION_STATE_SECRET="replace-with-a-long-random-secret"
# Base64-encoded 32-byte key for encrypted workspace integration and MCP credentials.
# Generate with: openssl rand -base64 32
INTEGRATION_CREDENTIAL_ENCRYPTION_KEY="replace-with-base64-encoded-32-byte-key"
# Google OAuth client (Gmail + Google Calendar integrations). Same client is used for both;
# they differ only by requested scopes. Authorized redirect URIs in Google Cloud Console:
# ${NEXT_PUBLIC_APP_URL}/api/integrations/gmail/callback
# ${NEXT_PUBLIC_APP_URL}/api/integrations/google-calendar/callback
# Optional stable broker callback for PR previews; when set, this exact URI must be
# authorized in Google Cloud Console and is used for both Gmail and Calendar starts.
# Hosted preview/prod value: https://oauth.opencompany.cloud/api/google/callback
GOOGLE_OAUTH_CALLBACK_URL=""
# The runner also needs CLIENT_ID/CLIENT_SECRET to refresh access tokens.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
# 32+ characters. Used only to sign Google OAuth setup state. Generate with: openssl rand -base64 32
GOOGLE_INTEGRATION_STATE_SECRET="replace-with-a-long-random-secret"
# 32+ characters. Used only to sign MCP OAuth setup state (separate from the
# credential encryption key). Goat Linear callback URL:
# ${GOAT_NEXT_PUBLIC_APP_URL:-NEXT_PUBLIC_APP_URL}/api/integrations/linear/callback
# Generate with: openssl rand -base64 32
MCP_OAUTH_STATE_SECRET="replace-with-a-long-random-secret"
# Slack hosted MCP OAuth app credentials. Callback URL:
# ${NEXT_PUBLIC_APP_URL}/api/mcp/slack/callback
SLACK_MCP_CLIENT_ID=""
SLACK_MCP_CLIENT_SECRET=""

# OC support Slack app — provisions a private Slack Connect channel per customer
# workspace after onboarding. Distinct from SLACK_MCP_* (that is read-only agent
# OAuth against the customer's Slack). Server-only; never NEXT_PUBLIC. Leave
# SLACK_SUPPORT_BOT_TOKEN empty to disable the feature (it no-ops, never crashes).
# Bot scopes: groups:write, groups:read, chat:write, conversations.connect:write.
# Slack Connect needs a PAID Slack plan (Pro/trial) — inviteShared errors "not_paid" on Free.
# TEAM_ID = T… (derive via auth.test); MEMBER_IDS = comma-separated U… of OC support
# people auto-invited to every channel. Full setup: docs/env-vars.md → "Slack support channel".
SLACK_SUPPORT_BOT_TOKEN=""
SLACK_SUPPORT_TEAM_ID=""
SLACK_SUPPORT_MEMBER_IDS=""

# WhatsApp messaging channel (Meta Cloud API). One shared platform Business number for all users;
# there are NO per-user WhatsApp credentials — a user is identified by their phone (wa_id) after
# linking via the Channels tab. Leave any of these empty to keep the feature dormant (the webhook
# acks but does nothing, and the Channels tab shows "Setup pending"). Configure the webhook in the
# Meta dashboard to point at: ${NEXT_PUBLIC_APP_URL}/api/webhooks/whatsapp
# The Cloud API phone-number id we send from (NOT the display number).
WHATSAPP_PHONE_NUMBER_ID=""
# A permanent system-user access token with whatsapp_business_messaging.
WHATSAPP_BUSINESS_ACCESS_TOKEN=""
# The Meta app secret — verifies inbound webhook signatures (X-Hub-Signature-256).
WHATSAPP_APP_SECRET=""
# The string set as the webhook Verify Token in the Meta dashboard (you choose this value).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
# Our public WhatsApp number in E.164 (e.g. +15551234567); used to build the wa.me link QR.
WHATSAPP_DISPLAY_NUMBER=""
# Optional Graph API version override (defaults to a recent stable version).
# WHATSAPP_GRAPH_API_VERSION="v21.0"

# Inngest background jobs.
INNGEST_EVENT_KEY="event-key..."
INNGEST_SIGNING_KEY="signkey-..."
# Local `bun run dev` forces this to 1 so placeholder cloud keys are not used.
INNGEST_DEV="1"
# Hosted preview deployments set this to route events into the matching Inngest branch env.
# INNGEST_ENV="preview-pr-123"
# Optional local dev port overrides. Usually leave these unset.
# PORT="3000"
# INNGEST_SDK_URL="http://localhost:3000/api/inngest"
# Optional stable ngrok origin for `bun run dev` and `bun run github:tunnel`.
# Local WorkOS redirects stay on localhost; ngrok is only for public integration callbacks.
OPENCOMPANY_NGROK_URL=""
# Optional ngrok auth token. Prefer `ngrok config add-authtoken` unless sharing dev setup via Infisical.
NGROK_AUTHTOKEN=""
# Set to 1 to fail `bun run dev` when ngrok cannot start.
OPENCOMPANY_NGROK_REQUIRED="0"
# Set to 1 to skip ngrok when running `bun run dev`.
OPENCOMPANY_NGROK_DISABLED="0"
# Optional Playwright web server port.
PLAYWRIGHT_PORT="3100"

# Agent runner. RUNNER_INTERNAL_URL is server-only for web/Inngest mutations.
# RUNNER_PUBLIC_URL is the browser-reachable hosted runner URL used by release
# smoke checks and as a server-side fallback when RUNNER_INTERNAL_URL is unset.
# The runner uses a pooled node-postgres driver against Neon's DIRECT (non-pooled)
# endpoint. By default it derives the direct host from DATABASE_URL by stripping the
# "-pooler" label; set RUNNER_DATABASE_URL to point it at an explicit direct URL.
RUNNER_DATABASE_URL=""
# Optional: max connections in the runner's DB pool (default 10). Size it as
# RUNNER_WORKER_CONCURRENCY plus headroom; keep instances * RUNNER_DB_POOL_MAX under
# Neon's max_connections (~901, shared with the web app + Inngest).
RUNNER_DB_POOL_MAX=""
# Optional: max parallel sessions per instance (default 8). Sessions are I/O-bound, so
# the ceiling is the event loop + E2B sandbox quota + gateway rate limits, not CPU/RAM.
RUNNER_WORKER_CONCURRENCY=""
# Optional: runner job delivery-lease TTL in ms (default 300000 = 5 min). Heartbeats every 5s while a
# job runs, so this only governs how long a stalled lease survives a deploy/recycle/GC gap before
# another instance may re-claim. It does not need to match long Codex/opencode command timeouts.
RUNNER_JOB_LEASE_TTL_MS=""
# Optional: max re-claims of a job while its run lease is busy elsewhere before giving up (default 10).
# Caps the runaway re-claim loop; the in-flight run still completes the message.
RUNNER_JOB_MAX_LEASE_BUSY_ATTEMPTS=""
RUNNER_PUBLIC_URL="http://localhost:3040"
RUNNER_INTERNAL_URL="http://localhost:3040"
RUNNER_INTERNAL_TOKEN="replace-with-a-long-random-secret"
# Runner signing secret used for hosted-tool polling job ids.
RUNNER_STREAM_TOKEN_SECRET="replace-with-a-different-long-random-secret"
RUNNER_ALLOWED_ORIGINS="http://localhost:3000"

# ElectricSQL real-time sync. The web app's TanStack DB collections sync durable
# rows (agents, session list rows, stars) out of Postgres via Electric. The
# browser never talks to Electric directly — it goes through the auth proxy at
# /api/electric/v1/shape, which scopes every shape to the caller's workspace/user.
# ELECTRIC_URL is the base URL of the Electric service (self-hosted Docker or
# Electric Cloud). The read layer is fully Electric-backed, so leaving this
# empty makes the proxy 503 and the agents/sessions UI has no data source —
# it does NOT degrade gracefully. For local dev, `bun run setup` starts a local
# Electric container and sets this automatically when a container runtime
# (OrbStack/Docker) is installed; it just needs logical replication enabled on
# the Neon project. `bun run electric:dev` runs it in the foreground to tail
# logs. See docs/stack/electric-sync.md.
# Electric needs Neon's DIRECT (non-pooled) connection with wal_level=logical.
ELECTRIC_URL=""
# Electric Cloud only: source id + secret. Omit for self-hosted Electric.
ELECTRIC_SOURCE_ID=""
ELECTRIC_SOURCE_SECRET=""
# Self-hosted Electric only: optional API token if the service requires auth.
ELECTRIC_TOKEN=""

# --- Durable Streams (live session transcript) ------------------------------
# The runner appends each session's runtime events (durable rows AND transient
# token deltas) to a per-session Durable Stream named `session-<sessionId>`; the
# web client consumes a resumable, offset-addressable transcript through a
# same-origin read proxy. This is the sole live transport.
# DURABLE_STREAMS_URL is the base URL appends/reads are made against. Leave it
# empty for local dev: `bun run dev` starts a local @durable-streams/server and
# injects this automatically (no Docker needed). Set it to override — e.g. the
# Electric Cloud Durable Streams base in prod,
# https://api.electric-sql.cloud/v1/stream/<service-id>.
# Provision (Electric Cloud): PUT $DURABLE_STREAMS_URL/<name> with the bearer token.
DURABLE_STREAMS_URL=""
# Bearer token for the Durable Streams service (runner write side; server-only —
# the browser reads via a same-origin proxy, never holding this token).
DURABLE_STREAMS_TOKEN=""

APIFY_API_TOKEN=
E2B_API_KEY="e2b_..."
# Used by web fast-model calls, the Goat default chat agent, and the runner.
VERCEL_AI_GATEWAY_API_KEY="vag_..."
# Vercel Blob — private `opencompany-attachments` store for user-uploaded message
# attachments (images/PDFs). Web mints client-upload tokens; the runner downloads bytes
# to inline into model calls. Prod value lives in Infisical `prod` /web + /runner.
# See docs/env-vars.md#vercel-blob-stores.
BLOB_READ_WRITE_TOKEN=""
# Optional Exa-backed search for Goat main chat and runner-hosted tools.
EXA_API_KEY="exa_..."
# Optional hosted tools.
SUPADATA_API_KEY=
X_API_BEARER_TOKEN=""
OPENCOMPANY_E2B_TEMPLATE=""
# Optional AMP coding-agent support. OPENCOMPANY_AMP_E2B_TEMPLATE defaults to E2B's "amp" template.
AMP_API_KEY="amp_..."
OPENCOMPANY_AMP_E2B_TEMPLATE=""
# Optional Codex coding-agent sandbox template. Defaults to E2B's "codex" template.
OPENCOMPANY_CODEX_E2B_TEMPLATE=""
# Optional Codex coding-agent support. RUNNER_CODEX_MODEL defaults to gpt-5.2-codex.
# Production Codex runs use the workspace Codex account connected in company settings.
RUNNER_CODEX_MODEL="gpt-5.2-codex"
# New E2B sandboxes auto-pause after this idle timeout and auto-resume on the next runner call.
RUNNER_E2B_IDLE_TIMEOUT_MS="30000"
# Wall-clock ceiling for a single opencode_coder delegation (default 20 min). On timeout the partial
# diff + resumable opencode session id are surfaced instead of failing.
RUNNER_OPENCODE_TIMEOUT_MS="1200000"
# Wall-clock ceiling for a single Codex engine turn or codex_coder delegation (default 1 hour).
# On timeout partial output is surfaced and pull request creation is skipped.
RUNNER_CODEX_TIMEOUT_MS="3600000"
# Kill switch for the model-based deferred-tool argument repair fallback. Deterministic validation
# and coercion always run; this only gates the small-model repair. Defaults to true.
RUNNER_TOOL_ARG_REPAIR_ENABLED="true"
# Sandbox callback URL: sandboxed CLIs use it for the runner's /broker/* LLM
# reverse proxy, and Goat tasks use it for runner-hosted Google tools
# (/goat/tools/*). Active only when a public runner URL is known: Render injects
# RENDER_EXTERNAL_URL in prod/preview. Local `bun run dev:goat` injects this
# automatically when ngrok is available by routing one public ngrok URL through a
# local proxy to the Goat app and runner.
# This is intentionally NOT RUNNER_PUBLIC_URL (above), which points at localhost
# in local dev.
# RUNNER_LLM_BROKER_ENABLED=false is the no-deploy kill switch.
RUNNER_LLM_BROKER_PUBLIC_URL=""
RUNNER_LLM_BROKER_ENABLED="true"
# Explicit fallback for Codex runs without a connected workspace account. Defaults to disabled in
# production and enabled outside production; set false to force device-auth locally.
RUNNER_CODEX_API_KEY_FALLBACK_ENABLED=""
# Platform OpenAI key for the Codex fallback path. Brokered fallback runs use it only server-side as
# the "openai" provider upstream credential; local-dev fallback maps it to CODEX_API_KEY.
# Use a budget-capped OpenAI project key.
OPENAI_CODEX_API_KEY=""
# Optional: stable runner identity for hosted multi-instance deployments. Defaults to host/pid/random.
RUNNER_INSTANCE_ID=""
# Optional for runner workspace cloning. Reuses the GitHub App env vars above when present.

# Feedback intake — Linear is the system of record.
LINEAR_API_KEY="lin_api_..."
LINEAR_TEAM_ID="00000000-0000-0000-0000-000000000000"
# Optional: route all app feedback to a Linear project and add extra comma-separated labels.
LINEAR_FEEDBACK_PROJECT_ID=""
LINEAR_FEEDBACK_LABELS="customer-feedback"

# Optional transactional email through Resend. Missing RESEND_API_KEY disables email sending locally.
RESEND_API_KEY=""
RESEND_WELCOME_FROM="Louis from opencompany <louis@updates.opencompany.cloud>"
RESEND_REPLY_TO="louis@opencompany.cloud"
# Resend Segment ID for the dashboard segment named "Registered Users".
RESEND_REGISTERED_USERS_SEGMENT_ID=""

# Optional PostHog analytics. Missing values disable analytics safely.
NEXT_PUBLIC_POSTHOG_TOKEN=""
NEXT_PUBLIC_POSTHOG_HOST=""
NEXT_PUBLIC_ANALYTICS_DEBUG="false"

# Optional launch observability. Missing DSNs disable remote error capture safely.
OBSERVABILITY_ENABLED="true"
OBSERVABILITY_ENV="development"
# Manual/non-Git deploy override. Hosted production derives release from platform commit metadata.
OBSERVABILITY_RELEASE=""
OBSERVABILITY_LOG_LEVEL="info"
# Optional verbose timing logs for debugging slow agent/GitHub paths.
OBSERVABILITY_TIMING="0"
# Legacy timing alias. Prefer OBSERVABILITY_TIMING for new setup.
OPENCOMPANY_TIMING="0"
# Optional Braintrust runner traces for agent/model/tool debugging. Disabled unless enabled and keyed.
BRAINTRUST_ENABLED="false"
BRAINTRUST_API_KEY=""
BRAINTRUST_PROJECT_ID=""
BRAINTRUST_PROJECT_NAME="OpenCompany Runner"
# Optional server-side override. The web app falls back to NEXT_PUBLIC_BETTER_STACK_ERRORS_DSN.
BETTER_STACK_ERRORS_DSN=""
# Optional: Sentry-compatible Better Stack DSN for web browser and server errors.
NEXT_PUBLIC_OBSERVABILITY_ENABLED="true"
NEXT_PUBLIC_OBSERVABILITY_ENV="development"
# Manual browser release override. Production release workflow injects the released commit SHA.
NEXT_PUBLIC_OBSERVABILITY_RELEASE=""
NEXT_PUBLIC_OBSERVABILITY_LOG_LEVEL="info"
NEXT_PUBLIC_BETTER_STACK_ERRORS_DSN=""
# Optional Goat OpenTelemetry export to SigNoz. Cloud endpoints usually use
# GOAT_OTEL_EXPORTER_OTLP_HEADERS="signoz-ingestion-key=<key>"; self-hosted usually leaves headers empty.
GOAT_OBSERVABILITY_ENABLED="false"
GOAT_OTEL_EXPORTER_OTLP_ENDPOINT=""
GOAT_OTEL_EXPORTER_OTLP_HEADERS=""

# Production release automation. These are normally fetched from Infisical `prod` + `/release`
# in GitHub Actions rather than used locally.
RENDER_SERVICE_ID=""
RENDER_API_KEY=""
RENDER_DEPLOY_TIMEOUT_MS="900000"
RENDER_DEPLOY_POLL_MS="10000"
SMOKE_WEB="true"
SMOKE_RUNNER="true"

# Preview provision automation. These are normally fetched from Infisical `dev` + `/release`
# in GitHub Actions rather than used locally.
PREVIEW_RENDER_LOG_ENDPOINT=""
PREVIEW_RENDER_LOG_TOKEN=""
