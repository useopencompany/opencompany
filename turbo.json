{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env", ".env.local", ".env.*.local"],
  "globalEnv": [
    "DATABASE_URL",
    "BETTER_STACK_ERRORS_DSN",
    "NEXT_PUBLIC_ANALYTICS_DEBUG",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_WORKOS_REDIRECT_URI",
    "AUTHKIT_DOMAIN",
    "MACOS_OAUTH_AUDIENCE",
    "MACOS_OAUTH_CLIENT_ID",
    "APP_PORT",
    "NEXT_PUBLIC_BETTER_STACK_ERRORS_DSN",
    "NEXT_PUBLIC_OBSERVABILITY_ENABLED",
    "NEXT_PUBLIC_OBSERVABILITY_ENV",
    "NEXT_PUBLIC_OBSERVABILITY_LOG_LEVEL",
    "NEXT_PUBLIC_OBSERVABILITY_RELEASE",
    "NEXT_PUBLIC_POSTHOG_HOST",
    "NEXT_PUBLIC_POSTHOG_TOKEN",
    "NEXT_PUBLIC_POSTHOG_HOST",
    "NEXT_PUBLIC_POSTHOG_TOKEN",
    "TELEMETRY_ENABLED",
    "OTEL_EXPORTER_OTLP_ENDPOINT",
    "OTEL_EXPORTER_OTLP_HEADERS",
    "NEXT_PUBLIC_WORKOS_REDIRECT_URI",
    "WORKOS_REDIRECT_URI",
    "GITHUB_APP_ID",
    "GITHUB_APP_INSTALLATION_ID",
    "GITHUB_APP_PRIVATE_KEY",
    "GITHUB_INTEGRATION_APP_ID",
    "GITHUB_INTEGRATION_APP_PRIVATE_KEY",
    "GITHUB_INTEGRATION_APP_SLUG",
    "GITHUB_INTEGRATION_APP_CLIENT_ID",
    "GITHUB_INTEGRATION_APP_CLIENT_SECRET",
    "GITHUB_INTEGRATION_STATE_SECRET",
    "GOOGLE_OAUTH_CLIENT_ID",
    "GOOGLE_OAUTH_CLIENT_SECRET",
    "GOOGLE_INTEGRATION_STATE_SECRET",
    "OBSERVABILITY_ENABLED",
    "OBSERVABILITY_ENV",
    "OBSERVABILITY_LOG_LEVEL",
    "OBSERVABILITY_RELEASE",
    "OBSERVABILITY_TIMING",
    "OPENCOMPANY_TIMING",
    "BRAINTRUST_ENABLED",
    "BRAINTRUST_API_KEY",
    "BRAINTRUST_PROJECT_ID",
    "BRAINTRUST_PROJECT_NAME",
    "OPENCOMPANY_E2B_TEMPLATE",
    "OPENCOMPANY_CODEX_E2B_TEMPLATE",
    "PORT",
    "RUNNER_ALLOWED_ORIGINS",
    "RUNNER_WORKERS_ENABLED",
    "RUNNER_INTERNAL_TOKEN",
    "RUNNER_INTERNAL_URL",
    "RUNNER_PUBLIC_URL",
    "RUNNER_STREAM_TOKEN_SECRET",
    "STRIPE_LISTEN_DISABLED",
    "STRIPE_LISTEN_EVENTS",
    "STRIPE_CLI_PROJECT_NAME",
    "E2B_API_KEY",
    "ELECTRIC_SECRET",
    "ELECTRIC_SOURCE_ID",
    "ELECTRIC_SOURCE_SECRET",
    "ELECTRIC_TOKEN",
    "ELECTRIC_URL",
    "EXA_API_KEY",
    "MONID_API_KEY",
    "CHAT_ACTIONS_KILL_SWITCH",
    "CHAT_SANDBOX_IMAGE",
    "IMESSAGE_PROVIDER",
    "IMESSAGE_KILL_SWITCH",
    "IMESSAGE_DAILY_CAP",
    "LINQ_API_TOKEN",
    "LINQ_FROM_NUMBER",
    "LINQ_API_BASE_URL",
    "MANAGED_CAPABILITIES_KILL_SWITCH",
    "DISABLED_MANAGED_CAPABILITY_ACTIONS",
    "LINEAR_API_KEY",
    "LINEAR_TEAM_ID",
    "PREVIEW_PR_NUMBER",
    "VERCEL_AI_GATEWAY_API_KEY",
    "WORKOS_API_KEY",
    "WORKOS_CLIENT_ID",
    "WORKOS_COOKIE_PASSWORD",
    "VERCEL_ENV",
    "VERCEL_GIT_COMMIT_SHA",
    "RENDER_GIT_COMMIT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "@opencompany/brain#build": {
      "dependsOn": ["^build"],
      "outputs": ["src/generated/cli-bundle.ts"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "lint:fix": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": ["tsconfig.tsbuildinfo"]
    }
  }
}
