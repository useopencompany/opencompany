{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env", ".env.local", ".env.*.local"],
  "globalEnv": [
    "DATABASE_URL",
    "DURABLE_STREAMS_URL",
    "DURABLE_STREAMS_TOKEN",
    "BETTER_STACK_ERRORS_DSN",
    "NEXT_PUBLIC_ANALYTICS_DEBUG",
    "NEXT_PUBLIC_APP_URL",
    "GOAT_NEXT_PUBLIC_APP_URL",
    "GOAT_NEXT_PUBLIC_WORKOS_REDIRECT_URI",
    "GOAT_PORT",
    "NEXT_PUBLIC_BETTER_STACK_ERRORS_DSN",
    "NEXT_PUBLIC_OBSERVABILITY_ENABLED",
    "NEXT_PUBLIC_OBSERVABILITY_ENV",
    "NEXT_PUBLIC_OBSERVABILITY_LOG_LEVEL",
    "NEXT_PUBLIC_OBSERVABILITY_RELEASE",
    "NEXT_PUBLIC_POSTHOG_HOST",
    "NEXT_PUBLIC_POSTHOG_TOKEN",
    "GOAT_OBSERVABILITY_ENABLED",
    "GOAT_OTEL_EXPORTER_OTLP_ENDPOINT",
    "GOAT_OTEL_EXPORTER_OTLP_HEADERS",
    "NEXT_PUBLIC_WORKOS_REDIRECT_URI",
    "WORKOS_REDIRECT_URI",
    "OPENCOMPANY_GITHUB_ORG",
    "GITHUB_APP_ID",
    "GITHUB_APP_INSTALLATION_ID",
    "GITHUB_APP_PRIVATE_KEY",
    "GITHUB_INTEGRATION_APP_ID",
    "GITHUB_INTEGRATION_APP_PRIVATE_KEY",
    "GITHUB_INTEGRATION_APP_SLUG",
    "GITHUB_INTEGRATION_APP_CLIENT_ID",
    "GITHUB_INTEGRATION_APP_CLIENT_SECRET",
    "GITHUB_INTEGRATION_STATE_SECRET",
    "GOOGLE_OAUTH_CLIENT_ID",
    "GOOGLE_OAUTH_CLIENT_SECRET",
    "GOOGLE_INTEGRATION_STATE_SECRET",
    "WHATSAPP_PHONE_NUMBER_ID",
    "WHATSAPP_BUSINESS_ACCESS_TOKEN",
    "WHATSAPP_APP_SECRET",
    "WHATSAPP_WEBHOOK_VERIFY_TOKEN",
    "WHATSAPP_DISPLAY_NUMBER",
    "WHATSAPP_GRAPH_API_VERSION",
    "INNGEST_DEV",
    "INNGEST_EVENT_KEY",
    "INNGEST_SDK_URL",
    "INNGEST_SIGNING_KEY",
    "OBSERVABILITY_ENABLED",
    "OBSERVABILITY_ENV",
    "OBSERVABILITY_LOG_LEVEL",
    "OBSERVABILITY_RELEASE",
    "OBSERVABILITY_TIMING",
    "OPENCOMPANY_TIMING",
    "BRAINTRUST_ENABLED",
    "BRAINTRUST_API_KEY",
    "BRAINTRUST_PROJECT_ID",
    "BRAINTRUST_PROJECT_NAME",
    "OPENCOMPANY_E2B_TEMPLATE",
    "AMP_API_KEY",
    "OPENCOMPANY_AMP_E2B_TEMPLATE",
    "OPENCOMPANY_CODEX_E2B_TEMPLATE",
    "PORT",
    "RUNNER_ALLOWED_ORIGINS",
    "RUNNER_INTERNAL_TOKEN",
    "RUNNER_INTERNAL_URL",
    "RUNNER_PUBLIC_URL",
    "RUNNER_STREAM_TOKEN_SECRET",
    "STRIPE_LISTEN_DISABLED",
    "STRIPE_LISTEN_EVENTS",
    "STRIPE_CLI_PROJECT_NAME",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "E2B_API_KEY",
    "ELECTRIC_SECRET",
    "ELECTRIC_SOURCE_ID",
    "ELECTRIC_SOURCE_SECRET",
    "ELECTRIC_TOKEN",
    "ELECTRIC_URL",
    "EXA_API_KEY",
    "LANGFUSE_PUBLIC_KEY",
    "LANGFUSE_SECRET_KEY",
    "LINEAR_API_KEY",
    "LINEAR_TEAM_ID",
    "LOGTAIL_SOURCE_TOKEN",
    "LOGTAIL_URL",
    "PREVIEW_PR_NUMBER",
    "VERCEL_AI_GATEWAY_API_KEY",
    "WORKOS_API_KEY",
    "WORKOS_CLIENT_ID",
    "WORKOS_COOKIE_PASSWORD",
    "VERCEL_ENV",
    "VERCEL_GIT_COMMIT_SHA",
    "RENDER_GIT_COMMIT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "lint:fix": {
      "cache": false
    },
    "test": {
      "dependsOn": ["^test"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "outputs": ["tsconfig.tsbuildinfo"]
    }
  }
}
