{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    ".env",
    ".env.local",
    ".env.*.local"
  ],
  "globalEnv": [
    "DATABASE_URL",
    "NEXT_PUBLIC_WORKOS_REDIRECT_URI",
    "OPENCOMPANY_GITHUB_ORG",
    "GITHUB_APP_ID",
    "GITHUB_APP_INSTALLATION_ID",
    "GITHUB_APP_PRIVATE_KEY",
    "INNGEST_DEV",
    "INNGEST_EVENT_KEY",
    "INNGEST_SDK_URL",
    "INNGEST_SIGNING_KEY",
    "OPENCOMPANY_TIMING",
    "PORT",
    "WORKOS_API_KEY",
    "WORKOS_CLIENT_ID",
    "WORKOS_COOKIE_PASSWORD"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "lint:fix": {
      "cache": false
    },
    "typecheck": {
      "dependsOn": [
        "^typecheck"
      ],
      "outputs": [
        "tsconfig.tsbuildinfo"
      ]
    }
  }
}
